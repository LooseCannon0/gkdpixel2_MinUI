# gkdpixel2 (RK3326S, ROCKNIX) — fast-boot build
# Point these at your build environment (see README "Building the binaries"):
#   XINC       SDL2/SDL_ttf/SDL_image headers matching the device's libs
#   XLIBS      symlink farm over the extracted SYSTEM squashfs's /usr/lib
#   SYSROOT_FS extracted SYSTEM squashfs root
XINC ?= $(HOME)/xinc
XLIBS ?= $(HOME)/xlibs
SYSROOT_FS ?= $(HOME)/sysroot/fs
ARCH = -mtune=cortex-a35 -march=armv8-a -O2 -I$(XINC) -I$(XINC)/SDL2 -I$(PREFIX)/include
LIBS = -L$(XLIBS) -L$(PREFIX)/lib -Wl,-rpath-link,$(SYSROOT_FS)/usr/lib
SDL = SDL2
