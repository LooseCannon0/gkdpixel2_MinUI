# gkdpixel2 (RK3326S, ROCKNIX) — fast-boot build
# Point these at your build environment (see README "Building the binaries"):
#   XINC       SDL2/SDL_ttf/SDL_image headers matching the device's libs
#   XLIBS      symlink farm over the extracted SYSTEM squashfs's /usr/lib
#   SYSROOT_FS extracted SYSTEM squashfs root
XINC ?= $(HOME)/xinc
XLIBS ?= $(HOME)/xlibs
SYSROOT_FS ?= $(HOME)/sysroot/fs
# -Werror=implicit-function-declaration: MinUI gets <string.h>/<stdlib.h> via
# SDL_stdinc.h, so a wrong SDL_config.h (SDL's generic one falls back to a
# minimal, libc-less config on Linux) silently turns strdup() & co. into
# int-returning implicit declarations — truncated pointers on aarch64.
ARCH = -mtune=cortex-a35 -march=armv8-a -O2 -Werror=implicit-function-declaration -I$(XINC) -I$(XINC)/SDL2 -I$(PREFIX)/include
LIBS = -L$(XLIBS) -L$(PREFIX)/lib -Wl,-rpath-link,$(SYSROOT_FS)/usr/lib
SDL = SDL2
